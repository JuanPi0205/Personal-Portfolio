---

<section
  id="skills"
  class="bg-[#EDEDED] text-black pb-24 flex flex-col items-center justify-center font-sans w-full"
>
  {/* Decorative Divider */}
  <div class="flex items-center gap-4 mb-20 mt-12">
    <div class="w-16 h-[2px] bg-black"></div>
    <div class="text-xl font-bold tracking-widest flex gap-1">
      <span>&#92;</span><span>&#92;</span><span>&#92;</span><span>/</span><span
        >/</span
      ><span>/</span>
    </div>
    <div class="w-16 h-[2px] bg-black"></div>
  </div>

  {/* Title Box */}
  <div class="border-[6px] border-black px-16 py-6 mb-24">
    <h2
      class="text-3xl font-extrabold tracking-[0.4em] uppercase ml-2 text-center"
    >
      Skills
    </h2>
  </div>

  <div class="w-full max-w-6xl px-6 flex flex-col gap-24">
    {
      skillCategories.map((category) => (
        <div class="flex flex-col w-full">
          <h3 class="text-xl font-bold tracking-[0.2em] uppercase mb-12 text-center md:text-left border-b-2 border-gray-300 pb-4">
            {category.title}
          </h3>

          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-y-16 gap-x-8 w-full place-items-center">
            {category.skills.map((skill) => (
              <div class="flex flex-col items-center gap-4 w-32 group">
                <img
                  src={skill.icon}
                  class="w-14 h-14 object-contain group-hover:scale-125 transition-transform duration-300 drop-shadow-sm"
                  alt={skill.name}
                  title={skill.name}
                />
                <span class="text-xs font-semibold tracking-widest uppercase text-gray-700 text-center leading-tight">
                  {skill.name}
                </span>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
