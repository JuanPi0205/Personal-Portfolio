---
// src/components/Footer.astro
---

<footer
  class="w-full bg-[#151515] text-white py-20 flex flex-col items-center justify-center font-sans"
>
  {/* Back to top */}
  <button
    id="back-to-top"
    class="flex flex-col items-center gap-3 group cursor-pointer hover:text-gray-400 transition-colors mb-12"
    onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="w-4 h-4 group-hover:-translate-y-1 transition-transform"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M4 15l8-8 8 8"
      ></path>
    </svg>
    <span class="text-[10px] tracking-[0.25em] font-extrabold uppercase mt-1"
      >Back to Top</span
    >
  </button>

  {/* Social Icons */}
  <div class="flex items-center gap-6">
    {/* LinkedIn Box */}
    <a
      href="https://www.linkedin.com/in/juan-jose-sánchez-pineda-01660623b"
      aria-label="LinkedIn"
      class="hover:text-gray-400 transition-colors"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="2" y="2" width="20" height="20" rx="3" ry="3"></rect>
        <path d="M8 11v5"></path>
        <path d="M8 8v.01"></path>
        <path d="M12 16v-5"></path>
        <path d="M16 16v-3a2 2 0 0 0 -4 0"></path>
      </svg>
    </a>

    {/* Instagram Box */}
    <a
      href="https://www.instagram.com/juanpi_023?igsh=N2JraGwwZmEycGlq&utm_source=qr"
      aria-label="Instagram"
      class="hover:text-gray-400 transition-colors"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="2" y="2" width="20" height="20" rx="3" ry="3"></rect>
        <circle cx="12" cy="12" r="4"></circle>
        <line x1="16.5" y1="7.5" x2="16.5" y2="7.501"></line>
      </svg>
    </a>

    {/* Email Envelope */}
    <a
      href="mailto:juanpineda200205@gmail.com"
      aria-label="Email"
      class="hover:text-gray-400 transition-colors"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="2" y="4" width="20" height="16" rx="3"></rect>
        <polyline points="2 8 12 14 22 8"></polyline>
      </svg>
    </a>
  </div>
</footer>
