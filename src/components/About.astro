---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  id="about"
  class="bg-[#EDEDED] text-black py-24 flex flex-col items-center justify-center font-sans w-full"
>
  {/* Title Box */}
  <div class="border-[6px] border-black px-16 py-6 mb-12">
    <h2 class="text-3xl font-extrabold tracking-[0.4em] uppercase ml-2">
      {t("about.title")}
    </h2>
  </div>

  {/* Description */}
  <p
    class="text-center text-gray-700 max-w-3xl mb-16 leading-relaxed px-6 text-[15px]"
  >
    {t("about.desc")}
  </p>

  {/* Explore Button */}
  <div class="flex items-center gap-6 mb-12 font-bold text-sm tracking-widest">
    <span class="w-[2px] h-6 bg-black"></span>
    <a href="#portfolio" class="hover:text-gray-500 transition"
      >{t("about.explore")}</a
    >
    <span class="w-[2px] h-6 bg-black"></span>
  </div>

  {/* Decorative Divider */}
  <div class="flex items-center gap-4 mb-24">
    <div class="w-16 h-[2px] bg-black"></div>
    <div class="text-xl font-bold tracking-widest flex gap-1">
      <span>&#92;</span><span>&#92;</span><span>&#92;</span><span>/</span><span
        >/</span
      ><span>/</span>
    </div>
    <div class="w-16 h-[2px] bg-black"></div>
  </div>

  {/* Services Section */}
  <div
    class="flex flex-wrap justify-center gap-y-24 gap-x-12 md:gap-x-32 max-w-6xl px-6 w-full"
  >
    {/* Design */}
    <div class="w-full md:w-[40%] flex gap-6 relative">
      <div
        class="absolute -left-6 -top-8 text-black opacity-5 pointer-events-none"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-32 h-32"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125"
          ></path>
        </svg>
      </div>
      <div class="flex-1 mt-6 z-10 relative">
        <h3
          class="text-xl font-extrabold tracking-[0.2em] uppercase mb-4 text-black"
        >
          {t("about.design.title")}
        </h3>
        <ul
          class="text-gray-600 text-sm leading-relaxed pr-4 list-disc ml-4 space-y-2"
        >
          <li>
            {t("about.design.li1")}
          </li>
          <li>
            {t("about.design.li2")}
          </li>
          <li>
            {t("about.design.li3")}
          </li>
        </ul>
      </div>
    </div>

    {/* Development */}
    <div class="w-full md:w-[40%] flex gap-6 relative">
      <div
        class="absolute -left-6 -top-8 text-black opacity-5 pointer-events-none"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-32 h-32"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"
          ></path>
        </svg>
      </div>
      <div class="flex-1 mt-6 z-10 relative">
        <h3
          class="text-xl font-extrabold tracking-[0.2em] uppercase mb-4 text-black"
        >
          {t("about.dev.title")}
        </h3>
        <p class="text-gray-600 text-sm leading-relaxed pr-4">
          <ul
            class="text-gray-600 text-sm leading-relaxed pr-4 list-disc ml-4 space-y-2"
          >
            <li>
              {t("about.dev.li1")}
            </li>
            <li>
              {t("about.dev.li2")}
            </li>
            <li>
              {t("about.dev.li3")}
            </li>
          </ul>
        </p>
      </div>
    </div>

    {/* Maintenance */}
    <div class="w-full md:w-[40%] flex gap-6 relative mt-4 md:mt-8">
      <div
        class="absolute -left-6 -top-8 text-black opacity-5 pointer-events-none"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-32 h-32"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M10.343 3.94c.09-.542.56-.94 1.11-.94h1.093c.55 0 1.02.398 1.11.94l.149.894c.07.424.384.764.78.93.398.164.855.142 1.205-.108l.737-.527a1.125 1.125 0 011.45.12l.773.774c.39.389.44 1.002.12 1.45l-.527.737c-.25.35-.272.806-.107 1.204.165.397.505.71.93.78l.893.15c.543.09.94.56.94 1.109v1.094c0 .55-.397 1.02-.94 1.11l-.893.149c-.425.07-.765.383-.93.78-.165.398-.143.854.107 1.204l.527.738c.32.447.269 1.06-.12 1.45l-.774.773a1.125 1.125 0 01-1.449.12l-.738-.527c-.35-.25-.806-.272-1.203-.107-.397.165-.71.505-.781.929l-.149.894c-.09.542-.56.94-1.11.94h-1.094c-.55 0-1.019-.398-1.11-.94l-.148-.894c-.071-.424-.384-.764-.781-.93-.398-.164-.854-.142-1.204.108l-.738.527c-.447.32-1.06.269-1.45-.12l-.773-.774a1.125 1.125 0 01-.12-1.45l.527-.737c.25-.35.273-.806.108-1.204-.165-.397-.505-.71-.93-.78l-.894-.15c-.542-.09-.94-.56-.94-1.109v-1.094c0-.55.398-1.02.94-1.11l.894-.149c.424-.07.765-.383.93-.78.165-.398.143-.854-.107-1.204l-.527-.738a1.125 1.125 0 01.12-1.45l.773-.773a1.125 1.125 0 011.45-.12l.737.527c.35.25.807.272 1.204.107.397-.165.71-.505.78-.929l.15-.894z"
          ></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
      </div>
      <div class="flex-1 mt-6 z-10 relative">
        <h3
          class="text-xl font-extrabold tracking-[0.2em] uppercase mb-4 text-black"
        >
          {t("about.maint.title")}
        </h3>
        <p class="text-gray-600 text-sm leading-relaxed pr-4">
          <ul
            class="text-gray-600 text-sm leading-relaxed pr-4 list-disc ml-4 space-y-2"
          >
            <li>
              {t("about.maint.li1")}
            </li>
            <li>
              {t("about.maint.li2")}
            </li>
            <li>
              {t("about.maint.li3")}
            </li>
          </ul>
        </p>
      </div>
    </div>
  </div>
</section>
