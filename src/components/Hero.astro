---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const currentPath = Astro.url.pathname;
const switchUrl =
  lang === "en"
    ? `/es${currentPath === "/" ? "" : currentPath}`
    : currentPath.replace(/^\/es/, "") || "/";

const ASSETS_S3 = import.meta.env.PUBLIC_ASSETS_S3;
const ASSETS_DOCS_S3 = import.meta.env.PUBLIC_ASSETS_DOCUMENTS_S3;
---

<section class="min-h-screen w-full flex bg-[#DCDCDC] overflow-hidden">
  <div
    class="w-1/2 flex flex-col justify-center px-12 md:px-24 relative z-10 py-12"
  >
    {/* Logo */}
    <div class="absolute top-8 left-12 md:left-24">
      <svg
        class="w-12 h-12 text-black"
        viewBox="0 0 48 48"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M20 16v12c0 2.2-1.8 4-4 4s-4-1.8-4-4v-2M26 32V16h6c2.2 0 4 1.8 4 4s-1.8 4-4 4h-6"
          stroke="currentColor"
          stroke-width="4"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </div>

    <div class="mt-20">
      <h2 class="text-2xl font-semibold mb-2">{t("hero.hi")}</h2>
      <h1 class="text-6xl font-bold mb-2">Juan Pineda</h1>
      <h3 class="text-xl text-gray-500 font-medium">{t("hero.role")}</h3>

      <div class="flex gap-4 mt-8">
        <a
          href="mailto:juanpineda200205@gmail.com"
          class="w-10 h-10 bg-gray-300 rounded flex items-center justify-center hover:bg-gray-400 transition"
        >
          <svg
            class="w-5 h-5 text-black"
            fill="currentColor"
            viewBox="0 0 24 24"
            ><path
              d="M12 12.713l-11.985-9.713h23.97l-11.985 9.713zm0 2.574l-12-9.725v15.438h24v-15.438l-12 9.725z"
            ></path></svg
          >
        </a>
        <a
          href="https://github.com/JuanPi0205"
          class="w-10 h-10 bg-gray-300 rounded flex items-center justify-center hover:bg-gray-400 transition"
        >
          <svg
            class="w-5 h-5 text-black"
            fill="currentColor"
            viewBox="0 0 24 24"
            ><path
              d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
            ></path></svg
          >
        </a>
        <a
          href="https://www.linkedin.com/in/juan-jose-sánchez-pineda-01660623b"
          class="w-10 h-10 bg-gray-300 rounded flex items-center justify-center hover:bg-gray-400 transition"
        >
          <svg
            class="w-5 h-5 text-black"
            fill="currentColor"
            viewBox="0 0 24 24"
            ><path
              d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
            ></path></svg
          >
        </a>
      </div>

      {/* CV Download Buttons */}
      <div class="flex flex-col sm:flex-row gap-4 mt-10">
        <a
          href={`${ASSETS_DOCS_S3}/JuanPinedaCV.pdf`}
          download="JuanPinedaCV.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3 bg-black text-white font-bold text-[10px] tracking-widest uppercase hover:bg-gray-800 transition shadow-lg text-center"
        >
          {t("hero.cv_es")}
        </a>
        <a
          href={`${ASSETS_DOCS_S3}/JuanPinedaCV___English.pdf`}
          download="JuanPinedaCV_English.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3 border-[2px] border-black text-black font-bold text-[10px] tracking-widest uppercase hover:bg-black hover:text-white transition shadow-lg text-center"
        >
          {t("hero.cv_en")}
        </a>
      </div>
    </div>
  </div>

  <div
    class="w-1/2 relative shadow-2xl flex flex-col pt-8 bg-cover bg-center"
    style={`clip-path: polygon(15% 0, 100% 0, 100% 100%, 0% 100%); background-image: url('${ASSETS_S3}/juanjo-hero-bg.jpg');`}
  >
    {
      /* Subtle gradient overlay at the top to ensure the white navbar is always readable against the bright sky */
    }
    <div
      class="absolute top-0 left-0 w-full h-32 bg-gradient-to-b from-black/60 to-transparent z-10 pointer-events-none"
    >
    </div>

    {/* Navigation */}
    <nav
      class="flex justify-end pr-12 gap-8 text-white font-medium text-sm z-20 relative items-center"
    >
      <a
        href="#about"
        class="hover:text-gray-200 drop-shadow-md transition mt-2"
        >{t("nav.about")}</a
      >
      <a
        href="#skills"
        class="hover:text-gray-200 drop-shadow-md transition mt-2"
        >{t("nav.skills")}</a
      >
      <a
        href="#portfolio"
        class="hover:text-gray-200 drop-shadow-md transition mt-2"
        >{t("nav.portfolio")}</a
      >

      {/* Language Switcher */}
      <a
        href={switchUrl}
        class="flex items-center gap-1 hover:text-gray-300 drop-shadow-md transition mt-2 ml-4 font-bold border-l pl-4 border-white/50"
        title="Cambiar idioma / Change language"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-5 h-5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418"
          ></path>
        </svg>
        {lang === "en" ? "ES" : "EN"}
      </a>

      <a
        href="https://wa.me/573228185189"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-white text-black px-6 py-2 rounded-full font-bold hover:bg-gray-200 transition shadow-lg ml-2"
        >{t("nav.contact")}</a
      >
    </nav>
  </div>
</section>

{/* Footer banner section */}
<section class="bg-[#1A1A1A] text-white p-12 md:p-24 relative overflow-hidden">
  {/* Large Background 'IT' */}
  <div
    class="absolute right-0 bottom-0 text-[20rem] font-bold text-white/5 leading-none translate-x-1/4 translate-y-1/4 pointer-events-none"
  >
    IT
  </div>

  <div class="max-w-4xl relative z-10">
    <h3 class="text-xl tracking-[0.2em] font-semibold mb-6">
      {t("footer.role")}
    </h3>
    <p class="text-sm text-gray-400 leading-relaxed max-w-3xl mb-8">
      {t("footer.desc")}
    </p>
    <a
      href="#about"
      class="inline-block border-l-2 border-white pl-4 text-sm font-semibold hover:text-gray-300 transition"
      >{t("footer.readmore")}</a
    >
  </div>
</section>
