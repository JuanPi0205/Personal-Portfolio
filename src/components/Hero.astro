---

---

<section class="h-screen w-full flex bg-[#DCDCDC] overflow-hidden">
  <div class="w-1/2 flex flex-col justify-center px-12 md:px-24">
    {/* Logo */}
    <div class="absolute top-8 left-12 md:left-24">
      <svg
        class="w-12 h-12 text-black"
        viewBox="0 0 24 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M12 2L2 7L12 12L22 7L12 2Z" fill="currentColor"></path>
        <path
          d="M2 17L12 22L22 17"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <path
          d="M2 12L12 17L22 12"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </div>

    {/* Content */}
    <div class="mt-20">
      <h2 class="text-2xl font-semibold mb-2">Hi, I am</h2>
      <h1 class="text-6xl font-bold mb-2">Juan Pineda</h1>
      <h3 class="text-xl text-gray-500 font-medium">Full Stack Developer</h3>

      {/* Social Icons */}
      <div class="flex gap-4 mt-8">
        <a
          href="#"
          class="w-10 h-10 bg-gray-300 rounded flex items-center justify-center hover:bg-gray-400 transition"
        >
          <svg
            class="w-5 h-5 text-black"
            fill="currentColor"
            viewBox="0 0 24 24"
            ><path
              d="M12 12.713l-11.985-9.713h23.97l-11.985 9.713zm0 2.574l-12-9.725v15.438h24v-15.438l-12 9.725z"
            ></path></svg
          >
        </a>
        <a
          href="#"
          class="w-10 h-10 bg-gray-300 rounded flex items-center justify-center hover:bg-gray-400 transition"
        >
          <svg
            class="w-5 h-5 text-black"
            fill="currentColor"
            viewBox="0 0 24 24"
            ><path
              d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
            ></path></svg
          >
        </a>
        <a
          href="#"
          class="w-10 h-10 bg-gray-300 rounded flex items-center justify-center hover:bg-gray-400 transition"
        >
          <svg
            class="w-5 h-5 text-black"
            fill="currentColor"
            viewBox="0 0 24 24"
            ><path
              d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
            ></path></svg
          >
        </a>
      </div>
    </div>
  </div>

  {/* Right Column: Dark Section */}
  <div
    class="w-1/2 bg-black relative shadow-2xl flex flex-col pt-8"
    style="clip-path: polygon(15% 0, 100% 0, 100% 100%, 0% 100%);"
  >
    {/* Navigation */}
    <nav class="flex justify-end pr-12 gap-8 text-white font-medium text-sm z-10">
      <a href="#about" class="hover:text-gray-300 transition mt-2">About me</a>
      <a href="#skills" class="hover:text-gray-300 transition mt-2">Skills</a>
      <a href="#portfolio" class="hover:text-gray-300 transition mt-2">Portfolio</a>
      <a href="#" class="bg-white text-black px-6 py-2 rounded-full font-bold hover:bg-gray-200 transition">CONTACT ME</a>
    </nav>
  </div>
</section>

{/* Footer banner section */}
<section class="bg-[#1A1A1A] text-white p-12 md:p-24 relative overflow-hidden">
  {/* Large Background 'IT' */}
  <div
    class="absolute right-0 bottom-0 text-[20rem] font-bold text-white/5 leading-none translate-x-1/4 translate-y-1/4 pointer-events-none"
  >
    IT
  </div>

  <div class="max-w-4xl relative z-10">
    <h3 class="text-xl tracking-[0.2em] font-semibold mb-6">IT BERRIES</h3>
    <p class="text-sm text-gray-400 leading-relaxed max-w-3xl mb-8">
      Nulla in velit a metus rhoncus tempus. Nulla congue nulla vel sem varius
      finibus. Sed ornare sit amet lorem sed viverra. In vel urna quis libero
      viverra facilisis ut ac est. Morbi commodo, eros in dignissim tempus,
      lacus odio rutrum augue, in semper sem magna quis tellus. Etiam enim erat,
      suscipit eu semper a, dictum sit amet elit. Nunc egestas nisi eget enim
      gravida facilisis. Pellentesque laoreet varius turpis vel pharetra. Ut
      ante justo, consequat vitae elementum tempor, accumsan nec eros.
    </p>
    <a
      href="#"
      class="inline-block border-l-2 border-white pl-4 text-sm font-semibold hover:text-gray-300 transition"
      >READ MORE</a
    >
  </div>
</section>
