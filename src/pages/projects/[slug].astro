---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects";
import type { Project } from "../../data/projects";

export async function getStaticPaths() {
  return projects.map((project) => {
    return {
      params: { slug: project.slug },
      props: { project },
    };
  });
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<Layout>
  <main
    class="w-full bg-[#1C1C1C] min-h-screen text-white font-sans selection:bg-gray-700 selection:text-white pb-24"
  >
    {/* Minimalist Navigation */}
    <nav
      class="w-full py-8 px-6 md:px-16 flex items-center border-b border-gray-800"
    >
      <a
        href="/#portfolio"
        class="text-sm tracking-[0.2em] uppercase text-gray-400 hover:text-white transition-colors duration-300 flex items-center gap-4 group"
      >
        <div
          class="w-8 h-[2px] bg-gray-500 group-hover:bg-white group-hover:-translate-x-2 transition-all duration-300"
        >
        </div>
        Back to Portfolio
      </a>
    </nav>

    {/* Main Content Area */}
    <header
      class="w-full max-w-7xl mx-auto px-6 md:px-16 pt-16 pb-12 opacity-0 animate-[fadeIn_1s_ease-out_forwards]"
    >
      {/* Type & Title */}
      <div class="mb-10">
        <p
          class="text-emerald-500 text-sm tracking-[0.2em] font-bold uppercase mb-4"
        >
          {project.type}
        </p>
        <h1
          class="text-5xl md:text-6xl font-extrabold tracking-wider mb-6 leading-tight"
        >
          {project.title}
        </h1>
      </div>

      {/* Description */}
      <div
        class="prose prose-invert prose-lg max-w-4xl text-gray-400 leading-relaxed font-light mb-16"
      >
        <p>{project.longDesc}</p>
      </div>

      {
        /* Tech Stack & Action Buttons (Optional, user didn't show in mockup but we keep it below description) */
      }
      <div
        class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8 mb-16"
      >
        <div class="flex flex-wrap gap-3">
          {
            project.techStack.map((tech) => (
              <span class="px-5 py-2 border border-gray-700 text-xs font-semibold tracking-widest text-gray-300 uppercase rounded-full bg-gray-900/30">
                {tech}
              </span>
            ))
          }
        </div>

        {project.githubLinks && project.githubLinks.length > 0 && (
          <div class="flex flex-wrap gap-4">
            {project.githubLinks.map((link) => (
              <a href={link.url} target="_blank" rel="noopener noreferrer" class="px-8 py-3 border border-white text-white font-bold uppercase text-xs tracking-[0.2em] hover:bg-white hover:text-black transition-colors rounded-full whitespace-nowrap">
                {link.label}
              </a>
            ))}
          </div>
        )}
      </div>

      {
        project.screenshots.length > 0 && (
          <div
            class={`grid gap-8 ${project.screenshots.length > 1 ? "md:grid-cols-2" : "grid-cols-1"} opacity-0 animate-[fadeIn_1s_ease-out_0.3s_forwards]`}
          >
            {project.screenshots.map((imgSrc, index) => (
              <div class="w-full overflow-hidden rounded-3xl border border-gray-800 group bg-[#121212] flex-grow">
                <img
                  src={imgSrc}
                  alt={`${project.title} screenshot ${index + 1}`}
                  loading="lazy"
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 opacity-90 group-hover:opacity-100"
                />
              </div>
            ))}
          </div>
        )
      }
    </header>
  </main>
</Layout>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
